{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vp check)",
      "Bash(vp check --fix)",
      "Bash(vp check --fix *)",
      "Bash(vp install)",
      "Bash(vp run ready)",
      "Bash(vp run *#ready)",
      "Bash(vp run skills:pixi)",
      "Bash(vp -C apps/game test)",
      "Bash(vp -C apps/game build)",
      "Bash(vp -C apps/game run e2e)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-after-edit.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
